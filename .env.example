# At least one provider key is required.

OPENROUTER_API_KEY=
INCEPTION_API_KEY=

# 智谱 AI Open Platform (BigModel) — see https://docs.bigmodel.cn/cn/api/introduction
# Accepts BIGMODEL_API_KEY or ZHIPU_API_KEY (same provider).
BIGMODEL_API_KEY=
# ZHIPU_API_KEY=

# Optional: use GLM Coding package endpoint instead of general paas v4.
# BIGMODEL_USE_CODING_ENDPOINT=true

# Optional: override full chat-completions URL (wins over BIGMODEL_USE_CODING_ENDPOINT).
# BIGMODEL_CHAT_COMPLETIONS_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

DEFAULT_PROVIDER=openrouter
